<!doctype html>
<html lang="en">
  <head>
    <%- include("partials/head", { title: "Monster Factory" }) %>
    <link rel="stylesheet" href="/css/testing.css" />
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <!---------------------------------------->
    <!--Nav Bar-->
    <header id="Nav_output"></header>
    <!---------------------------------------->
    <div class="filter-grid">SOME FILTRS GO HERE</div>
    <div class="btn-group">
      <button class="btn" id="btn-generate">Generate</button>
      <button class="btn" id="btn-random">Randomise</button>
      <button class="btn" id="btn-export" onclick="exportCreature()">
        Export
      </button>
    </div>
    <br />
    <!---------------------------------------->
    <div class="container" id="main-creature">
      <section class="creature-media">
        <img
          src=""
          class="creature-media-image"
          id="creature-media-image"
          alt="Illustration of the creature"
        />
        <div class="creature-attribute">
          <img src="" class="creature-media-icon" id="attribute-icon-out" />
          <div class="creature-media-header">
            <div id="attribute-out"></div>
          </div>
        </div>
        <div class="creature-type">
          <img src="" class="creature-media-icon" id="type-icon-out" />
          <div class="creature-media-header">
            <div id="type-out"></div>
            <div id="tags-out"></div>
          </div>
        </div>
        <div class="creature-perk">
          <img src="" class="creature-media-icon" id="perk-icon-out" />
          <div class="creature-media-header"><div id="perk-out"></div></div>
        </div>
      </section>

      <!--------------------------------
      Right here are some notes, so we dont forget. 

      Name goes in the container for the stateblock, we need to stule the statblock
       obviously an ensure we include things like the edition, and size tags, they 
       can go under the name

      It also seems that the name and description go with the picture, the idea 
      being that someone could in theory export the state block only. So be smart,
       you need to splut it into two halves
      
      
      
      
      -------->

      <section id="statblockContainer" class="mf-statblock">
        <!---------------------------------------->
        <!--Creature Name & Description-->
        <section class="mf-statblock-header">
          <h1 id="name-out"></h1>
          <p id="desc-out"></p>
          <p>
            <span id="alignment-out" class="creature-alignment"></span>
            <span id="size-out" class="creature-size"></span>
            <span id="edition-out" class="creature-edition"></span>
          </p>
        </section>

        <div class="divider"></div>
        <section id="Content Base Stats">
          <div>
            <span class="category-header">Armor Class: </span
            ><span class="category-body" id="mf-acclass"></span>
          </div>
          <div>
            <span class="category-header">Hit Points: </span
            ><span class="category-body" id="mf-hpclass"></span>
          </div>
          <div>
            <span class="category-header">Speed: </span
            ><span class="category-body" id="mf-speed"></span>
          </div>
        </section>
        <table class="mf-abilities">
          <tr class="stat-label">
            <th>STR</th>
            <th>DEX</th>
            <th>CON</th>
            <th>INT</th>
            <th>WIS</th>
            <th>CHA</th>
          </tr>
          <tr>
            <td id="STR-out"></td>
            <td id="DEX-out"></td>
            <td id="CON-out"></td>
            <td id="INT-out"></td>
            <td id="WIS-out"></td>
            <td id="CHA-out"></td>
          </tr>
        </table>
        <div class="divider"></div>
        <div class="mf-extra">
          <div>
            <span class="category-header">Saving Throws: </span
            ><span class="category-body" id="mf-save"></span>
          </div>
          <div>
            <span class="category-header">Skills: </span
            ><span class="category-body" id="mf-skill"></span>
          </div>
          <div>
            <span class="category-header">Senses: </span
            ><span class="category-body" id="mf-senses"></span>
          </div>
          <div>
            <span class="category-header">Damage Immunities: </span
            ><span class="category-body" id="mf-immune"></span>
          </div>
          <div>
            <span class="category-header">Condition Immunities: </span
            ><span class="category-body" id="mf-conditionImmune"></span>
          </div>
          <div>
            <span class="category-header">Languages: </span
            ><span class="category-body" id="mf-languages"></span>
          </div>
        </div>
        <div class="divider"></div>
        <h3 class="mf-section-title">Traits</h3>
        <div class="mf-traits" id="mf-traits"></div>
        <div class="divider"></div>
        <h3 class="mf-section-title">Actions</h3>
        <div class="mf-actions" id="mf-actions"></div>
      </section>

      <!---------------------------------------->
      <!--Creature Stat Blocks-->

      <section class="abilities-grid">
        <div class="card stat-container" id="STR-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="STR-label">Str</div>
          <div class="stat-value" id="STR-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="DEX-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="DEX-label">Dex</div>
          <div class="stat-value" id="DEX-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="CON-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="CON-label">Con</div>
          <div class="stat-value" id="CON-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="INT-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="INT-label">Int</div>
          <div class="stat-value" id="INT-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="WIS-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="WIS-label">Wis</div>
          <div class="stat-value" id="WIS-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="CHA-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="CHA-label">Cha</div>
          <div class="stat-value" id="CHA-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </section>
      <!---------------------------------------->
      <!--Info Cards: Defence & Proficiences-->
      <div class="info-grid defence">
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Defence</div>
          <div class="category-header">Armour Class:</div>
          <div class="category-body" id="ac-out"></div>
          <div class="category-header">Hit Points:</div>
          <div class="category-body" id="hp-out"></div>
          <div class="category-header">Speed:</div>
          <div class="category-body" id="speed-out"></div>
          <div class="category-header">Challenge Rating (Base):</div>
          <div class="category-body" id="cr-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <!---------------------------------------->
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Proficiencies & Senses</div>
          <div class="category-header">Saving Throws:</div>
          <div class="category-body" id="saves-out"></div>
          <div class="category-header">Skills:</div>
          <div class="category-body" id="skills-out"></div>
          <div class="category-header">Senses:</div>
          <div class="category-body" id="senses-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
      <!---------------------------------------->
      <!--Info Cards: Charactistics-->
      <div class="info-grid">
        <div class="card info-container full">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Characteristics</div>
          <div class="category-header">Vulnerabilities:</div>
          <div class="category-body" id="vulnerable-out"></div>
          <div class="category-header">Damage Resistances:</div>
          <div class="category-body" id="resist-out"></div>
          <div class="category-header">Damage Immunities:</div>
          <div class="category-body" id="immune-out"></div>
          <div class="category-header">Condition Immunities:</div>
          <div class="category-body" id="conditionImmune-out"></div>
          <div class="category-header">Languages:</div>
          <div class="category-body" id="languages-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
      <!---------------------------------------->
      <!--Info Cards: Traits-->
      <div class="info-grid">
        <div class="card info-container full">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Traits</div>
          <div id="traits-container"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
      <!---------------------------------------->
      <!--Info Cards: Actions & Spells-->
      <div class="info-grid">
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Actions</div>
          <div id="actions-container"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <!---------------------------------------->
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Spellcasting</div>
          <div id="spellcasting-container"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
      <!---------------------------------------->
      <!--Info Cards: Reactions & Source-->
      <div class="info-grid source">
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Reactions</div>
          <div id="reactions-container"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card info-container" id="source-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title centre">Source</div>
          <div class="source-book" id="source-out"></div>
          <div class="page-number" id="page-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
    </div>
    <div
      id="export-image"
      style="
        position: absolute;
        left: -9999px;
        top: -9999px;
        pointer-events: none;
        width: 750px;
      "
    >
      <div class="export-footer">
        © 2026 RyanFuturistics | MonsterFactory™ | All rights reserved.
      </div>
    </div>
    <!--Footer-->
    <footer id="Ftr_output"></footer>
    <!--END-->
  </body>
</html>
<script src="/js/tippy/popper.min.js" defer></script>
<script src="/js/tippy/tippy.umd.min.js" defer></script>
<script src="/js/engine-exporter.js" defer></script>
<script src="/js/engine-monsterfactory.js" defer></script>
<script src="/js/navigation-core.js" defer></script>
<script src="/js/navigation-engine.js" defer></script>
<script
  src="https://html2canvas.hertzen.com/dist/html2canvas.js"
  defer
></script>
<script src="/js/config.js" defer></script>
