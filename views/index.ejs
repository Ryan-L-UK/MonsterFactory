<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!---------------------------------------->
    <!-- Info & Description -->
    <title>The Monster Factory</title>
    <meta
      name="description"
      content="Enter the MonsterFactory: a forge for handcrafted and procedurally generated D&D creatures. Create unique monsters, explore curated designs, and fuel your campaigns with fresh, lore-rich encounters."
    />
    <link rel="canonical" href="https://monsterfactory.app/" />
    <!---------------------------------------->
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/UI/Styles/main.css" />
    <link rel="stylesheet" href="/Engine/lib/tippy/tippy.css" />
    <!---------------------------------------->
    <link
      rel="preload"
      href="/UI/Components/ButtonStyling/buttonBase.jpeg"
      as="image"
    />
    <link
      rel="preload"
      href="/UI/Components/ButtonStyling/buttonHighlight.jpeg"
      as="image"
    />
    <link
      rel="preload"
      href="/UI/Components/ButtonStyling/goldButton.png"
      as="image"
    />
    <!---------------------------------------->
    <!-- Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!---------------------------------------->
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://monsterfactory.app/" />
    <meta property="og:site_name" content="MonsterFactory" />
    <meta property="og:title" content="The Monster Factory" />
    <meta
      property="og:description"
      content="Generate handcrafted and procedurally built D&D monsters with unique traits, origins, and lore."
    />
    <meta
      property="og:image"
      content="https://monsterfactory.app/UI/Components/Logos/social-card.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!---------------------------------------->
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="The Monster Factory" />
    <meta
      name="twitter:description"
      content="A forge for handcrafted and procedurally generated D&D creatures."
    />
    <meta
      name="twitter:image"
      content="https://monsterfactory.app/UI/Components/Logos/social-card.png"
    />
    <!---------------------------------------->
    <!-- Theme -->
    <meta name="theme-color" content="#05070b" />
    <!---------------------------------------->
    <!-- JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "The Monster Factory",
        "url": "https://monsterfactory.app/",
        "applicationCategory": "Game",
        "description": "A forge for handcrafted and procedurally generated D&D creatures.",
        "operatingSystem": "All"
      }
    </script>
  </head>
  <body>
    <!---------------------------------------->
    <!--Nav Bar-->
    <header id="Nav_output"></header>
    <!---------------------------------------->
    <div class="filter-grid">
      <div class="filter-item">
        <label for="mf-cr">CR:</label>
        <div class="mf-select-wrapper">
          <select class="mf-select frame" id="mf-cr" name="mf-cr">
            <option value="" selected>Any</option>
            <% crList.forEach(cr => { %>
            <option value="<%= cr %>"><%= cr %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="filter-item">
        <label for="mf-attribute">Attribute:</label>
        <div class="mf-select-wrapper frame">
          <select class="mf-select" id="mf-attribute" name="mf-attribute">
            <option value="" selected>Any</option>
            <% attributeList.forEach(attr => { %>
            <option value="<%= attr %>"><%= attr %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="filter-item">
        <label for="mf-type">Creature Type:</label>
        <div class="mf-select-wrapper">
          <select class="mf-select" id="mf-type" name="mf-type">
            <option value="" selected>Any</option>
            <% typeList.forEach(type => { %>
            <option value="<%= type %>"><%= type %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="filter-item">
        <label for="mf-perk">Perk:</label>
        <div class="mf-select-wrapper">
          <select class="mf-select" id="mf-perk" name="mf-perk">
            <option value="" selected>Any</option>
            <% perkList.forEach(perk => { %>
            <option value="<%= perk %>"><%= perk %></option>
            <% }) %>
          </select>
        </div>
      </div>
    </div>
    <div class="button-container">
      <button class="submit-button" id="btn-generate">Generate</button>
      <button class="submit-button" id="btn-random">Randomise</button>
      <button class="submit-button" id="btn-export" onclick="exportCreature()">
        Export
      </button>
    </div>
    <br />
    <!---------------------------------------->
    <div class="container" id="main-creature">
      <section class="creature-media">
        <img
          src=""
          class="creature-media-image"
          id="creature-media-image"
          alt="Illustration of the creature"
        />
        <div class="creature-attribute">
          <img src="" class="creature-media-icon" id="attribute-icon-out" />
          <div class="creature-media-header">
            <div id="attribute-out"></div>
          </div>
        </div>
        <div class="creature-type">
          <img src="" class="creature-media-icon" id="type-icon-out" />
          <div class="creature-media-header">
            <div id="type-out"></div>
            <div id="tags-out"></div>
          </div>
        </div>
        <div class="creature-perk">
          <img src="" class="creature-media-icon" id="perk-icon-out" />
          <div class="creature-media-header"><div id="perk-out"></div></div>
        </div>
      </section>
      <!---------------------------------------->
      <!--Creature Name & Description-->
      <section class="centre">
        <h1 id="name-out"></h1>
        <p id="desc-out"></p>
        <p>
          <span id="alignment-out" class="creature-alignment"></span>
          <span id="size-out" class="creature-size"></span>
        </p>
      </section>
      <!---------------------------------------->
      <!--Creature Stat Blocks-->
      <section class="abilities-grid">
        <div class="card stat-container" id="STR-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="STR-label">Str</div>
          <div class="stat-value" id="STR-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="DEX-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="DEX-label">Dex</div>
          <div class="stat-value" id="DEX-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="CON-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="CON-label">Con</div>
          <div class="stat-value" id="CON-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="INT-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="INT-label">Int</div>
          <div class="stat-value" id="INT-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="WIS-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="WIS-label">Wis</div>
          <div class="stat-value" id="WIS-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card stat-container" id="CHA-Container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="stat-label" id="CHA-label">Cha</div>
          <div class="stat-value" id="CHA-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </section>
      <!---------------------------------------->
      <!--Info Cards: Defence & Proficiences-->
      <div class="info-grid defence">
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Defence</div>
          <div class="category-header">Armour Class:</div>
          <div class="category-body" id="ac-out"></div>
          <div class="category-header">Hit Points:</div>
          <div class="category-body" id="hp-out"></div>
          <div class="category-header">Speed:</div>
          <div class="category-body" id="speed-out"></div>
          <div class="category-header">Challenge Rating (Base):</div>
          <div class="category-body" id="cr-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <!---------------------------------------->
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Proficiencies & Senses</div>
          <div class="category-header">Saving Throws:</div>
          <div class="category-body" id="saves-out"></div>
          <div class="category-header">Skills:</div>
          <div class="category-body" id="skills-out"></div>
          <div class="category-header">Senses:</div>
          <div class="category-body" id="senses-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
      <!---------------------------------------->
      <!--Info Cards: Charactistics-->
      <div class="info-grid">
        <div class="card info-container full">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Characteristics</div>
          <div class="category-header">Vulnerabilities:</div>
          <div class="category-body" id="vulnerable-out"></div>
          <div class="category-header">Damage Resistances:</div>
          <div class="category-body" id="resist-out"></div>
          <div class="category-header">Damage Immunities:</div>
          <div class="category-body" id="immune-out"></div>
          <div class="category-header">Condition Immunities:</div>
          <div class="category-body" id="conditionImmune-out"></div>
          <div class="category-header">Languages:</div>
          <div class="category-body" id="languages-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
      <!---------------------------------------->
      <!--Info Cards: Traits-->
      <div class="info-grid">
        <div class="card info-container full">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Traits</div>
          <div id="traits-container"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
      <!---------------------------------------->
      <!--Info Cards: Actions & Spells-->
      <div class="info-grid">
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Actions</div>
          <div id="actions-container"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <!---------------------------------------->
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Spellcasting</div>
          <div id="spellcasting-container"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
      <!---------------------------------------->
      <!--Info Cards: Reactions & Source-->
      <div class="info-grid source">
        <div class="card info-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title">Reactions</div>
          <div id="reactions-container"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
        <div class="card info-container" id="source-container">
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="section-title centre">Source</div>
          <div class="source-book" id="source-out"></div>
          <div class="page-number" id="page-out"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
        </div>
      </div>
    </div>
    <div
      id="export-image"
      style="
        position: absolute;
        left: -9999px;
        top: -9999px;
        pointer-events: none;
        width: 750px;
      "
    >
      <div class="export-footer">
        © 2026 RyanFuturistics | MonsterFactory™ | All rights reserved.
      </div>
    </div>
    <!--Footer-->
    <footer id="Ftr_output"></footer>
    <!--END-->
  </body>
</html>
<script src="/Engine/lib/tippy/popper.min.js" defer></script>
<script src="/Engine/lib/tippy/tippy.umd.min.js" defer></script>
<script src="/Engine/engine-exporter.js" defer></script>
<script src="/Engine/engine-monsterfactory.js" defer></script>
<script src="/Engine/navigation-core.js" defer></script>
<script src="/Engine/navigation-engine.js" defer></script>
<script
  src="https://html2canvas.hertzen.com/dist/html2canvas.js"
  defer
></script>
<script src="/Engine/config.js" defer></script>
